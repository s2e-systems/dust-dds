enum Suits { Spades, Hearts, Diamonds, Clubs };

@bit_bound(16)
enum HttpStatusCode {
    @value(100)
    CONTINUE,
    @value(200)
    OK,
    @value(300)
    MULTIPLE_CHOICES,
    @value(400)
    BAD_REQUEST,
    @value(404)
    NOT_FOUND,
    @value(500)
    INTERNAL_SERVER_ERROR
};

enum Priority {
    LOW,
    @default_literal
    MEDIUM,
    HIGH
};

@appendable
enum ExtensibleEnum {
    V1,
    V2
};